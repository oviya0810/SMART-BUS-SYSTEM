# ============================================================================
# SMARTBUS 360 configuration. Copy to .env (setup_windows.bat does this and
# generates SECRET_KEY automatically). Never commit .env.
# ============================================================================

# --- Security -----------------------------------------------------------------
# Long random string. If empty, one is generated and stored in backend/instance/secret_key
SECRET_KEY=
# true only when serving over HTTPS
SESSION_COOKIE_SECURE=false
SESSION_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# --- Network ------------------------------------------------------------------
HOST=0.0.0.0
# 80 = http://bus.local with no port. Use 443 together with SSL_* below for HTTPS.
PORT=80
PUBLIC_BASE_URL=http://bus.local
# Browser origins allowed for cross-origin API/Socket.IO calls (same-origin is always allowed)
CORS_ORIGINS=http://bus.local,http://localhost:5173,http://127.0.0.1:5173

# Optional HTTPS (required by browsers for the student "Use my GPS" feature on phones)
# Generate with scripts\generate_https_cert.bat
SSL_CERT_FILE=
SSL_KEY_FILE=

# Optional: advertise bus.local over mDNS from this PC (see docs/NETWORK_SETUP.md)
MDNS_ENABLED=false
MDNS_HOSTNAME=bus.local
# Leave empty to auto-detect the LAN IP
MDNS_IP=

# --- Database -----------------------------------------------------------------
# Default: backend/instance/smartbus360.db
DATABASE_URL=

# --- Data freshness & hardware ------------------------------------------------
GPS_STALE_SECONDS=60
OCCUPANCY_STALE_SECONDS=120
ALCOHOL_STALE_SECONDS=120
DEVICE_OFFLINE_SECONDS=90
DEVICE_HEARTBEAT_INTERVAL_SECONDS=30
DEVICE_MAX_FUTURE_SKEW_SECONDS=300
DEVICE_MAX_PAST_AGE_HOURS=72
COMMAND_EXPIRY_MINUTES=30
# Default MQ-3 warning threshold (raw 12-bit ADC). Configurable per bus in the admin UI.
ALCOHOL_DEFAULT_THRESHOLD=2000
ALCOHOL_ADC_MAX=4095
SOS_LAST_KNOWN_GPS_MAX_AGE_SECONDS=300

# --- Misc ---------------------------------------------------------------------
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
BACKGROUND_MONITOR=true
